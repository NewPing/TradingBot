# ── Runtime ───────────────────────────────────────────
ATLAS_ENV=dev                    # dev | research | live
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_FORMAT=console         # console | json
ATLAS_TZ_DISPLAY=Europe/Berlin

# ── SAFETY ────────────────────────────────────────────
ATLAS_ALLOW_LIVE=false           # NEVER set true without reading MASTER_PLAN §9
ATLAS_ALLOW_SHORT=false
ATLAS_MAX_LEVERAGE=1.0
ATLAS_HOLDOUT_LOCKED=true

# ── Capital ───────────────────────────────────────────
ATLAS_VIRTUAL_CAPITAL_USD=100000
ATLAS_BUCKET_ALLOC=CORE:0.50,SWING:0.30,MOONSHOT:0.15,CASH:0.05

# ── Storage ───────────────────────────────────────────
ATLAS_DB_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5432/atlas
ATLAS_REDIS_URL=redis://localhost:6379/0
ATLAS_DATA_DIR=./data
ATLAS_SNAPSHOT_DIR=./data/snapshots

# ── Providers ─────────────────────────────────────────
TIINGO_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
FMP_API_KEY=
POLYGON_API_KEY=

# ── LLM (Phase 7, Unraid) ─────────────────────────────
ATLAS_LLM_BASE_URL=http://localhost:8080/v1
ATLAS_LLM_MODEL=Qwen3.8-27B-Q4
ATLAS_LLM_PROMPT_VERSION=v1.0

# ── Alerting ──────────────────────────────────────────
ATLAS_ALERT_EMAIL=
ATLAS_SMTP_URL=
ATLAS_NTFY_TOPIC=

# ── API / Web ─────────────────────────────────────────
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8001
ATLAS_SESSION_SECRET=dev_session_secret_replace_in_production
NEXT_PUBLIC_API_URL=http://localhost:8001
